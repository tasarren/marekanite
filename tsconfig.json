  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/src/**/*.vue",
    "packages/**/*.config.ts",
    "vitest.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
