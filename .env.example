# Copy to .env for `docker compose` (optional overrides)

# Public origin patched clients must reach (REST + Sync WS, same host:port)
PUBLIC_API_BASE=http://127.0.0.1:8787

# Host port mapping
HTTP_PORT=8787

# Optional. If unset, the admin UI is open (no unlock screen).
# Set a long random hex to require unlock on /admin/*.
# MAREKANITE_ADMIN_TOKEN=

# Optional limits (bytes)
# STORAGE_LIMIT_BYTES=10737418240
# PER_FILE_MAX=208666624

# Android APK signing (optional — auto-generates debug keystore under data/apk-signing/)
# APK_KEYSTORE_PATH=/data/apk-signing/debug.keystore
# APK_KEYSTORE_PASS=change-me
# APK_KEY_ALIAS=marekanite
# APK_KEY_PASS=change-me

# Optional GitHub token if release listing hits rate limits
# GITHUB_TOKEN=
